# syntax=docker/dockerfile:1
# Build context: school-app/   (docker build -f Dockerfile.frontend school-app)
ARG NODE_IMAGE=node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.30-alpine@sha256:f5116ed4606f3eb015dd4a8e28cb9b351476dc0ad4bc6e9f93b19cec130cdf03

FROM ${NODE_IMAGE} AS manifests
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json backend/
COPY frontend/package.json frontend/
COPY tests/package.json tests/

FROM manifests AS build
RUN --mount=type=cache,target=/root/.npm npm ci --workspace frontend
COPY frontend frontend
RUN npm run build -w frontend

# Runtime: static files + nginx as a non-root user (uid 101). Root filesystem can be read-only.
FROM ${NGINX_IMAGE} AS runtime
# Temporary: the pinned base ships libexpat 2.9.0-r0 (CVE-2026-113351, fixed in 2.10.0-r0) and the Trivy gate blocks it.
# Remove this block once the upstream tag is rebuilt with the fix and the NGINX_IMAGE digest above is bumped.
USER 0
RUN apk upgrade --no-cache libexpat
USER 101
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html
EXPOSE 8080
