{
  "name": "school-app",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22 <23" },
  "workspaces": ["backend", "frontend", "tests"],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w backend -w frontend",
    "test:unit": "npm run test:unit -w backend -w frontend",
    "test:integration": "npm run test:integration -w backend"
  }
}
